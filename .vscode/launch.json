{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "執行 MOV 轉 MP4",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Server running at (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "執行（手機可連線，LAN）",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "args": ["--lan"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Server running at (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
